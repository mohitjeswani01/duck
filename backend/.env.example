# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# "development" or "production" — not currently branching behavior on this, but kept
# for any future environment-specific logic (e.g. verbose error responses in dev only).
ENVIRONMENT=development

# Local port for `uvicorn`. Render ignores this and injects its own PORT at runtime —
# the start command must read $PORT, not this value, in production.
PORT=8000

# Neon Postgres connection string. Use the asyncpg driver form:
# postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host/duck

# Google AI Studio model alias. Defaults to Google's official "always current Flash"
# alias so we never hardcode a guessed version string. Run
# backend/scripts/list_gemini_models.py after setting GEMINI_API_KEYS to see exactly
# which model this resolves to, and scripts/benchmark_models.py to compare real
# latency/reliability across candidates before pinning a specific name here —
# the fastest/most-reliable model right now isn't always the newest one.
GEMINI_MODEL=gemini-flash-latest

# Tried on every key only after every key is exhausted/cooling for GEMINI_MODEL —
# a separate quota bucket on Google's side, so a model-wide outage or quota
# exhaustion doesn't take Duck down mid-demo.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Comma-separated Gemini API keys from 2-3 DIFFERENT Google accounts, for automatic
# round-robin + failover via app/services/gemini_key_pool.py. Get one at
# https://aistudio.google.com/apikey per account.
GEMINI_API_KEYS=key_one,key_two,key_three

# How long (seconds) a key that hit a 429/quota error is skipped before the pool
# tries it again.
GEMINI_KEY_COOLDOWN_SECONDS=60

# How long (seconds) a key that hit a 5xx (server overloaded/unavailable) error or
# a call timeout is skipped before the pool tries it again — shorter than the quota
# cooldown above, since these are usually transient (a different key often
# succeeds within seconds) rather than a real quota/auth problem.
GEMINI_SERVER_ERROR_COOLDOWN_SECONDS=15

# Hard ceiling on total Gemini calls per day across ALL visitors, to protect quota
# before a demo. Raise this on demo day if needed — no redeploy required if set via
# the hosting platform's env var UI.
GEMINI_DAILY_CALL_CAP=500

# Wall-clock budget (seconds) for a single generate_content call (one key, one
# model attempt). Kept short so a hung call fails over to the next key quickly
# instead of blocking the whole turn for the full duration.
GEMINI_CALL_TIMEOUT_SECONDS=25

# Hard wall-clock ceiling (seconds) for one ENTIRE user turn — every key
# retry, model fallback, and tool-calling loop iteration combined. Without
# this, a turn's total duration is only bounded by GEMINI_CALL_TIMEOUT_SECONDS
# * (num_keys * 2 models) * MAX_TOOL_CALLS_PER_TURN, which multiplies out to
# tens of minutes during a sustained Gemini outage. When this hits mid-turn,
# Duck sends a locally-built summary of what it found so far (no further
# Gemini call, so it can't itself hang) instead of leaving the session stuck.
GEMINI_TURN_DEADLINE_SECONDS=90

# Hard cap on total Gemini SDK call attempts for one logical "Gemini call" in
# the tool-calling loop, summed across every key AND both models (not per
# key) — independent of the deadline above.
GEMINI_MAX_ATTEMPTS_PER_CALL=6

# Gemini 3.x models "think" before responding by default (MEDIUM), which adds
# measurable latency on every call. LOW for the investigating-phase tool-calling
# loop (mechanical orchestration — list_files/read_file/search_code); the higher
# level below kicks in once past pure investigation. Valid: MINIMAL, LOW, MEDIUM, HIGH.
GEMINI_THINKING_LEVEL=LOW
# Used once a session is past investigating (hypothesis/fix_proposed/resolved) —
# few calls, but each is precision-sensitive (propose_fix's exact line numbers,
# the resolution summary), worth the extra latency.
GEMINI_HYPOTHESIS_THINKING_LEVEL=MEDIUM

# Older tool-call results beyond this many most-recent ones get their bulky
# payload replaced with a short placeholder before the next Gemini call, so
# long sessions don't blow up context size or cost.
GEMINI_CONTEXT_KEEP_RECENT_TOOL_RESULTS=6

# GitHub token, optional. Used automatically if set; otherwise Duck falls back to
# GitHub's unauthenticated rate limit (60 req/hr), which is fine since repo connect
# only makes 2 calls (metadata + tarball). Create a FINE-GRAINED token at
# https://github.com/settings/tokens?type=beta with "Public Repositories (read-only)"
# access and no other permissions.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Timeout (seconds) for GitHub metadata/tarball requests.
GITHUB_REQUEST_TIMEOUT_SECONDS=20

# Repo ingestion caps — connecting a repo downloads one tarball and keeps only
# filtered text files under these limits. Repos over the cap are rejected with a
# friendly message rather than partially imported.
REPO_MAX_FILES=500
REPO_MAX_FILE_BYTES=200000
REPO_MAX_TOTAL_BYTES=5000000

# How long (seconds) a connected repo's stored copy is reused before Duck
# re-downloads and re-extracts it.
REPO_CACHE_TTL_SECONDS=3600

# Caps on what the list_files / read_file / search_code tools return, so one
# huge result can't blow up Gemini's context or hang the server.
TOOL_LIST_FILES_MAX_RESULTS=200
TOOL_READ_FILE_MAX_LINES=300
TOOL_SEARCH_MAX_RESULTS=50
TOOL_SEARCH_TIMEOUT_SECONDS=3
TOOL_OUTPUT_MAX_CHARS=20000

# Enables POST /dev/tools/* for curl-testing the file tools directly. Must be
# false in production.
ENABLE_DEV_TOOLS=true

# Comma-separated list of origins allowed to call this API. Include the deployed
# Vercel URL and localhost for local dev. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# Abuse protection — all env vars so they can be raised on demo day without a deploy.
RATE_LIMIT_SESSIONS_PER_IP_PER_HOUR=5
RATE_LIMIT_MESSAGES_PER_SESSION=40
# Per user turn (one message's worth of back-and-forth), not per session.
MAX_TOOL_CALLS_PER_TURN=15

# Conversation engine (Phase 3)
MAX_CLARIFYING_ROUNDS=2
MIN_QUESTIONS_PER_ROUND=1
MAX_QUESTIONS_PER_ROUND=3
# In-memory per-session SSE queue depth — fine since Render's free tier is a
# single instance; see CLAUDE.md "Conversation engine" for the tradeoff.
SESSION_EVENT_QUEUE_MAX_SIZE=200
