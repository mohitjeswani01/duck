# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# "development" or "production" — not currently branching behavior on this, but kept
# for any future environment-specific logic (e.g. verbose error responses in dev only).
ENVIRONMENT=development

# Local port for `uvicorn`. Render ignores this and injects its own PORT at runtime —
# the start command must read $PORT, not this value, in production.
PORT=8000

# Neon Postgres connection string. Use the asyncpg driver form:
# postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host/duck

# Google AI Studio model alias. Defaults to Google's official "always current Flash"
# alias so we never hardcode a guessed version string. Run
# backend/scripts/list_gemini_models.py after setting GEMINI_API_KEYS to see exactly
# which model this resolves to, and pin a specific name here only if you want to.
GEMINI_MODEL=gemini-flash-latest

# Comma-separated Gemini API keys from 2-3 DIFFERENT Google accounts, for automatic
# round-robin + failover via app/services/gemini_key_pool.py. Get one at
# https://aistudio.google.com/apikey per account.
GEMINI_API_KEYS=key_one,key_two,key_three

# How long (seconds) a key that hit a 429/quota error is skipped before the pool
# tries it again.
GEMINI_KEY_COOLDOWN_SECONDS=60

# Hard ceiling on total Gemini calls per day across ALL visitors, to protect quota
# before a demo. Raise this on demo day if needed — no redeploy required if set via
# the hosting platform's env var UI.
GEMINI_DAILY_CALL_CAP=500

# GitHub personal access token, read-only, "public_repo" scope is sufficient since
# Duck only ever reads public repositories. Raises the API rate limit from 60/hr
# (unauthenticated) to 5000/hr. Create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of origins allowed to call this API. Include the deployed
# Vercel URL and localhost for local dev. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# Abuse protection — all env vars so they can be raised on demo day without a deploy.
RATE_LIMIT_SESSIONS_PER_IP_PER_HOUR=5
RATE_LIMIT_MESSAGES_PER_SESSION=40
MAX_TOOL_CALLS_PER_SESSION=15
